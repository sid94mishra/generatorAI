{
  "tag": "T2",
  "description": "conditional routing (F T2)",
  "timeoutMs": 900000,
  "variables": {
    "env": "prod",
    "count": 5,
    "flag": false,
    "sflag": "false"
  },
  "def": {
    "name": "e2e-t2-conditions",
    "sessionMode": "auto",
    "variables": [
      {
        "name": "env",
        "type": "string",
        "label": "env"
      },
      {
        "name": "count",
        "type": "number",
        "label": "count"
      },
      {
        "name": "flag",
        "type": "boolean",
        "label": "flag"
      },
      {
        "name": "sflag",
        "type": "string",
        "label": "sflag"
      }
    ]
  },
  "stages": [
    {
      "name": "R",
      "prompt": "Write one line containing the token ROOT."
    },
    {
      "name": "C_and",
      "prompt": "Write one line containing the token C_AND.",
      "condition": {
        "type": "expression",
        "expression": "variables.env == 'prod' AND variables.count > 3"
      }
    },
    {
      "name": "C_or_false",
      "prompt": "Write one line containing the token C_OR.",
      "condition": {
        "type": "expression",
        "expression": "variables.env == 'dev' OR variables.count < 2"
      }
    },
    {
      "name": "C_not",
      "prompt": "Write one line containing the token C_NOT.",
      "condition": {
        "type": "expression",
        "expression": "NOT variables.flag"
      }
    },
    {
      "name": "C_bang_str",
      "prompt": "Write one line containing the token C_BANG.",
      "condition": {
        "type": "expression",
        "expression": "!variables.sflag"
      }
    },
    {
      "name": "C_amp",
      "prompt": "Write one line containing the token C_AMP.",
      "condition": {
        "type": "expression",
        "expression": "status == 'completed' && variables.count >= 5"
      }
    },
    {
      "name": "C_paren",
      "prompt": "Write one line containing the token C_PAREN.",
      "condition": {
        "type": "expression",
        "expression": "(variables.env == 'prod' || variables.env == 'staging') && !(variables.count == 5)"
      }
    },
    {
      "name": "C_lower",
      "prompt": "Write one line containing the token C_LOWER.",
      "condition": {
        "type": "expression",
        "expression": "variables.env == 'prod' and variables.count > 3"
      }
    },
    {
      "name": "C_stageref",
      "prompt": "Write one line containing the token C_STAGEREF.",
      "condition": {
        "type": "expression",
        "expression": "stages.R.status == 'completed'"
      }
    },
    {
      "name": "D_after_skip",
      "prompt": "Write one line containing the token D."
    },
    {
      "name": "J",
      "prompt": "Write one line containing the token JOIN."
    },
    {
      "name": "J_always",
      "prompt": "Write one line containing the token JALWAYS."
    }
  ],
  "edges": [
    [
      "R",
      "C_and"
    ],
    [
      "R",
      "C_or_false"
    ],
    [
      "R",
      "C_not"
    ],
    [
      "R",
      "C_bang_str"
    ],
    [
      "R",
      "C_amp"
    ],
    [
      "R",
      "C_paren"
    ],
    [
      "R",
      "C_lower"
    ],
    [
      "R",
      "C_stageref"
    ],
    [
      "C_or_false",
      "D_after_skip"
    ],
    [
      "C_and",
      "J"
    ],
    [
      "C_or_false",
      "J"
    ],
    [
      "C_or_false",
      "J_always",
      "always"
    ]
  ]
}
