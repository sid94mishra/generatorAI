{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Pinned Codex app-server v1.0.0 JSON-RPC schema — generated from pinned binary types. Do not hand-edit.",
  "title": "Codex app-server JSON-RPC API",
  "description": "codex app-server exposes a JSON-RPC 2.0 interface over stdio or TCP.",
  "definitions": {
    "JsonRpcRequest": {
      "type": "object",
      "required": ["jsonrpc", "method", "id"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
        "method": { "type": "string" },
        "params": {}
      }
    },
    "JsonRpcResponse": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
        "result": {},
        "error": { "$ref": "#/definitions/JsonRpcError" }
      }
    },
    "JsonRpcError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer", "description": "-32001 = rate limited (use exponential backoff)" },
        "message": { "type": "string" },
        "data": {}
      }
    },
    "JsonRpcNotification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "type": "string", "enum": ["2.0"] },
        "method": { "type": "string" },
        "params": {}
      }
    },
    "SessionCreateParams": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/definitions/ToolSpec" }
        },
        "maxTurns": { "type": "integer" }
      }
    },
    "SessionCreateResult": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "type": "string" }
      }
    },
    "TurnParams": {
      "type": "object",
      "required": ["sessionId", "input"],
      "properties": {
        "sessionId": { "type": "string" },
        "input": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/definitions/TurnAttachment" }
        }
      }
    },
    "TurnSteerParams": {
      "type": "object",
      "required": ["sessionId", "signal"],
      "properties": {
        "sessionId": { "type": "string" },
        "signal": {
          "type": "string",
          "enum": ["cancel", "continue"],
          "description": "Maps to the Signal primitive. 'cancel' stops the turn."
        }
      }
    },
    "TurnEvent": {
      "type": "object",
      "required": ["type", "sessionId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["turn.start", "token", "tool.call", "tool.result", "turn.end", "error"]
        },
        "sessionId": { "type": "string" },
        "token": { "type": "string" },
        "toolCall": { "$ref": "#/definitions/ToolCall" },
        "toolResult": { "$ref": "#/definitions/ToolResult" },
        "stopReason": {
          "type": "string",
          "enum": ["end_turn", "length", "tool_use", "cancelled"]
        },
        "usage": { "$ref": "#/definitions/Usage" },
        "error": { "$ref": "#/definitions/JsonRpcError" }
      }
    },
    "ToolCall": {
      "type": "object",
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "input": { "type": "object" }
      }
    },
    "ToolResult": {
      "type": "object",
      "required": ["toolCallId"],
      "properties": {
        "toolCallId": { "type": "string" },
        "content": { "type": "string" },
        "isError": { "type": "boolean" }
      }
    },
    "ToolSpec": {
      "type": "object",
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" }
      }
    },
    "TurnAttachment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["image", "file"] },
        "base64": { "type": "string" },
        "mimeType": { "type": "string" },
        "filePath": { "type": "string" }
      }
    },
    "Usage": {
      "type": "object",
      "properties": {
        "inputTokens": { "type": "integer" },
        "outputTokens": { "type": "integer" },
        "cacheReadTokens": { "type": "integer" },
        "cacheWriteTokens": { "type": "integer" }
      }
    },
    "ModelListResult": {
      "type": "object",
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "items": { "$ref": "#/definitions/ModelInfo" }
        }
      }
    },
    "ModelInfo": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contextLength": { "type": "integer" },
        "supportsReasoning": { "type": "boolean" }
      }
    }
  },
  "methods": {
    "session.create": {
      "params": { "$ref": "#/definitions/SessionCreateParams" },
      "result": { "$ref": "#/definitions/SessionCreateResult" }
    },
    "session.delete": {
      "params": { "type": "object", "required": ["sessionId"], "properties": { "sessionId": { "type": "string" } } },
      "result": { "type": "null" }
    },
    "turn": {
      "params": { "$ref": "#/definitions/TurnParams" },
      "result": { "type": "null" },
      "notifications": { "$ref": "#/definitions/TurnEvent" }
    },
    "turn.steer": {
      "params": { "$ref": "#/definitions/TurnSteerParams" },
      "result": { "type": "null" }
    },
    "model.list": {
      "params": { "type": "null" },
      "result": { "$ref": "#/definitions/ModelListResult" }
    }
  }
}
