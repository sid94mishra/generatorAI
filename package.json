{
  "name": "generatorai",
  "version": "0.0.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @generatorai/server dev",
    "dev:web": "pnpm --filter @generatorai/web dev",
    "start:web": "turbo dev --filter=@generatorai/server --filter=@generatorai/web",
    "start:cli": "pnpm --filter @generatorai/cli cli --",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint && pnpm run check:security && pnpm run check:tokens",
    "typecheck": "turbo typecheck",
    "check:security": "node scripts/check-no-app-wide-cdp.mjs && node scripts/check-security-invariants.mjs",
    "check:tokens": "pnpm --filter @generatorai/design-tokens tokens:check",
    "tokens:write": "pnpm --filter @generatorai/design-tokens tokens:write",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:backup": "pnpm --filter @generatorai/server exec tsx ../../scripts/db-backup.ts",
    "db:generate": "pnpm --filter @generatorai/db db:generate",
    "db:reset": "pnpm --filter @generatorai/db db:reset",
    "db:prepare-dist": "pnpm --filter @generatorai/db db:prepare-dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "electron-builder",
      "esbuild-register",
      "node-pty",
      "onnxruntime-node",
      "sharp"
    ],
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  }
}
