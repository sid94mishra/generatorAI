{
  "name": "generatorai",
  "version": "0.0.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@generatorai/server --filter=@generatorai/web",
    "dev:server": "pnpm --filter @generatorai/server dev",
    "dev:web": "pnpm --filter @generatorai/web dev",
    "dev:desktop": "pnpm --filter @generatorai/desktop dev",
    "dev:cli": "pnpm --filter @generatorai/cli dev --",
    "dev:relay": "pnpm --filter @generatorai/relay dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:scripts": "vitest run scripts/__tests__ --project node",
    "lint": "turbo lint && pnpm run check:security && pnpm run check:durability && pnpm run check:docs && pnpm run check:syncio && pnpm run check:tokens && pnpm run check:workflow-invariants && pnpm run check:no-legacy && pnpm run check:migrations-lock && pnpm run check:db-baseline && pnpm run check:workflow-spec",
    "typecheck": "turbo typecheck",
    "check:security": "node scripts/check-no-app-wide-cdp.mjs && node scripts/check-security-invariants.mjs",
    "check:durability": "node scripts/check-durability-invariants.mjs",
    "check:docs": "node scripts/check-doc-drift.mjs",
    "check:syncio": "node scripts/check-sync-io-budget.mjs",
    "check:tokens": "pnpm --filter @generatorai/design-tokens tokens:check",
    "check:workflow-invariants": "node scripts/check-workflow-invariants.mjs",
    "check:no-legacy": "node scripts/check-no-legacy.mjs",
    "check:migrations-lock": "node scripts/check-migrations-lock.mjs",
    "check:db-baseline": "pnpm --filter @generatorai/db exec tsx ../../scripts/generate-db-baseline.ts --check",
    "check:workflow-spec": "pnpm --filter @generatorai/server exec tsx ../../scripts/generate-workflow-spec.ts --check",
    "cli:docs": "pnpm --filter @generatorai/cli docs",
    "cli:docs:check": "pnpm --filter @generatorai/cli docs:check",
    "package:desktop": "pnpm --filter @generatorai/desktop package",
    "preview:desktop": "pnpm --filter @generatorai/desktop preview",
    "verify:release": "pnpm --filter @generatorai/desktop verify:release",
    "tokens:write": "pnpm --filter @generatorai/design-tokens tokens:write",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r exec node -e \"const fs=require('fs');for(const d of ['dist','dist-bundle','dist-electron','.turbo'])fs.rmSync(d,{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f,{force:true})\"",
    "postinstall": "node scripts/fix-native-exec-bits.mjs",
    "generate:schemas": "pnpm --filter @generatorai/server exec tsx ../../scripts/generate-schemas.ts",
    "generate:workflow-spec": "pnpm --filter @generatorai/server exec tsx ../../scripts/generate-workflow-spec.ts",
    "db:backup": "pnpm --filter @generatorai/server exec tsx ../../scripts/db-backup.ts",
    "db:reclaim": "pnpm --filter @generatorai/server exec tsx ../../scripts/db-reclaim.ts",
    "db:generate": "pnpm --filter @generatorai/db db:generate",
    "db:check": "pnpm --filter @generatorai/db db:check",
    "db:baseline": "pnpm --filter @generatorai/db exec tsx ../../scripts/generate-db-baseline.ts",
    "db:reset": "pnpm --filter @generatorai/db db:reset",
    "db:prepare-dist": "pnpm --filter @generatorai/db db:prepare-dist",
    "sweep:temp": "node scripts/sweep-temp-workspaces.mjs",
    "workflow:backup": "node scripts/workflow-backup.mjs",
    "workflow:e2e": "node scripts/workflow-e2e/run.mjs",
    "workflow:cleanup-runs": "node scripts/workflow-cleanup-runs.mjs",
    "workflow:dbcopy-upgrade": "node scripts/workflow-dbcopy-upgrade.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "electron-builder",
      "esbuild-register",
      "node-pty",
      "onnxruntime-node",
      "sharp"
    ],
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^22.10.0",
      "protobufjs@7": "^7.6.6",
      "protobufjs@8": "^8.8.0",
      "@protobufjs/utf8": "^1.1.1"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  }
}
