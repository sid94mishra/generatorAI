# Build context for docker/server.Dockerfile. Anything listed here never
# reaches the daemon — keeps the context small and, more importantly, keeps
# local databases, vault key material and packaging output out of the image.
.git
.github
.claude
.turbo
**/.turbo
**/node_modules
**/dist
**/dist-bundle
**/dist-electron
**/release
**/coverage
**/*.tsbuildinfo
**/test-results
**/.playwright-cli

# Runtime data — a checkout's local DB must never ship inside an image.
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
**/data/*.db-journal
**/data/secrets
**/data/delta-logs
*.db
*.db-wal
*.db-shm

# Secrets and local overrides
.env
.env.*

# Not needed to build the server
apps/mobile
apps/desktop
docs
oldDocs
agent-tests
