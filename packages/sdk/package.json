{
  "name": "@generatorai/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "GeneratorAI SDK — INTERNAL, unpublished. Embeds the server's core/db/harness graph in-process; see README.md.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "API-STABILITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@generatorai/shared": "workspace:*",
    "@generatorai/core": "workspace:*",
    "@generatorai/db": "workspace:*",
    "@generatorai/agent-harness-providers": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "dag",
    "orchestration",
    "sdk",
    "copilot",
    "claude"
  ]
}
