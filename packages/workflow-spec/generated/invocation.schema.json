{
  "$id": "https://generatorai.dev/schemas/invocation.schema.json",
  "$comment": "Generated by scripts/generate-workflow-spec.ts from @generatorai/workflow-spec. Do not edit.",
  "$ref": "#/definitions/InvocationRequest",
  "definitions": {
    "InvocationRequest": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "definition",
                  "description": "Run a saved workflow definition"
                },
                "workflowDefinitionId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Definition id"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Published version; omitted means the current published version"
                },
                "testRun": {
                  "type": "boolean",
                  "description": "Run the draft as a test version (user principals only)"
                }
              },
              "required": [
                "kind",
                "workflowDefinitionId"
              ],
              "additionalProperties": false,
              "description": "Definition target"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "script",
                  "description": "Materialize (once per script content) and run a workflow script"
                },
                "scriptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Script id"
                }
              },
              "required": [
                "kind",
                "scriptId"
              ],
              "additionalProperties": false,
              "description": "Script target"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "fork",
                  "description": "Fork an earlier run, re-running from the given instances"
                },
                "sourceRunId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Run to fork"
                },
                "rerunFrom": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "maxItems": 50,
                  "description": "Instance paths to re-run from; omitted means the failed instances"
                },
                "definition": {
                  "type": "string",
                  "enum": [
                    "pinned",
                    "latest"
                  ],
                  "default": "pinned",
                  "description": "Definition version of the fork"
                },
                "workspace": {
                  "type": "string",
                  "enum": [
                    "restore_checkpoint",
                    "reuse",
                    "fresh"
                  ],
                  "default": "fresh",
                  "description": "fresh provisions a new workspace; reuse runs in the source one; restore_checkpoint reuses it rolled back to before the earliest re-run instance"
                }
              },
              "required": [
                "kind",
                "sourceRunId"
              ],
              "additionalProperties": false,
              "description": "Fork target"
            }
          ],
          "description": "What to run"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {},
          "description": "Variable values by name; engine-reserved names are refused",
          "default": {}
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "description": "Project whose codebases the run may mount"
        },
        "codebases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "pattern": "^[A-Za-z0-9._-]+$",
                "description": "Alias of a project codebase"
              },
              "baseRef": {
                "type": "string",
                "maxLength": 200,
                "description": "Branch or ref the mount is cut from; omitted means the default branch"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "worktree",
                  "in_place"
                ],
                "default": "worktree",
                "description": "worktree: isolated; in_place: edits the checkout (requires admin:settings)"
              }
            },
            "required": [
              "alias"
            ],
            "additionalProperties": false,
            "description": "A codebase the run mounts"
          },
          "maxItems": 10,
          "description": "Codebases to mount; omitted means lifecycle.codebaseAliases"
        },
        "stageOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stageKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$",
                "description": "Stage to override"
              },
              "skip": {
                "type": "boolean",
                "description": "Skip the stage for this run"
              },
              "variables": {
                "$ref": "#/definitions/InvocationRequest/properties/variables",
                "description": "Variable values by name; engine-reserved names are refused"
              },
              "model": {
                "type": "string",
                "maxLength": 200,
                "description": "Model for this stage in this run"
              }
            },
            "required": [
              "stageKey"
            ],
            "additionalProperties": false,
            "description": "Per-stage override for one run"
          },
          "maxItems": 100,
          "description": "Per-stage overrides, by stage key"
        },
        "overrides": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 200,
              "description": "Model for every stage without its own"
            },
            "harnessType": {
              "type": "string",
              "enum": [
                "copilot",
                "claude-agent",
                "codex",
                "opencode",
                "acp"
              ],
              "description": "Agent provider"
            },
            "reasoningEffort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ],
              "description": "Reasoning effort"
            },
            "permissionMode": {
              "type": "string",
              "enum": [
                "plan",
                "default",
                "acceptEdits",
                "bypassPermissions"
              ],
              "description": "Permission mode; capped by the caller ceiling"
            }
          },
          "additionalProperties": false,
          "description": "Run-wide overrides"
        },
        "uploads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uploadId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "Id returned by the uploads endpoint"
              },
              "category": {
                "type": "string",
                "enum": [
                  "skills",
                  "agents",
                  "prompts"
                ],
                "description": "Upload category"
              }
            },
            "required": [
              "uploadId",
              "category"
            ],
            "additionalProperties": false,
            "description": "A staged upload"
          },
          "maxItems": 60,
          "description": "Files staged before the run starts"
        },
        "profile": {
          "type": "string",
          "maxLength": 200,
          "description": "A script target's exported run profile; this request's own inputs win over it"
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Run name"
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxDurationMs": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 86400000,
              "description": "Wall clock for the whole run"
            },
            "maxChildRuns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50,
              "description": "Nested invocations this run and its descendants may make"
            },
            "maxTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Token budget"
            },
            "maxCostUsd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "description": "Cost budget in USD"
            }
          },
          "additionalProperties": false,
          "description": "Run budget"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$",
          "description": "Replays return the same run; for clients that cannot send the Idempotency-Key header"
        },
        "client": {
          "type": "string",
          "enum": [
            "web",
            "desktop",
            "mobile",
            "cli",
            "tui",
            "sdk",
            "mcp",
            "http"
          ],
          "description": "Client label; the server decides the trigger"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false,
      "description": "The one request that starts a workflow run"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
