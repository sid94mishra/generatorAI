{
  "name": "@generatorai/agent-harness-providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./copilot": {
      "import": "./src/providers/copilot/index.ts",
      "types": "./src/providers/copilot/index.ts"
    },
    "./claude-agent": {
      "import": "./src/providers/claude-agent/index.ts",
      "types": "./src/providers/claude-agent/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./copilot": {
        "types": "./dist/providers/copilot/index.d.ts",
        "import": "./dist/providers/copilot/index.js"
      },
      "./claude-agent": {
        "types": "./dist/providers/claude-agent/index.d.ts",
        "import": "./dist/providers/claude-agent/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@generatorai/core": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "saxes": "^6.0.0",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "yauzl": "^3.4.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.319",
    "@github/copilot-sdk": "1.0.29",
    "@openai/codex": "0.167.0"
  },
  "devDependencies": {
    "@types/unbzip2-stream": "^1.4.3",
    "@types/yauzl": "^3.4.0"
  }
}
