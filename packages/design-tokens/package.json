{
  "name": "@generatorai/design-tokens",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./emit": {
      "import": "./src/emit/index.ts",
      "types": "./src/emit/index.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./emit": {
        "types": "./dist/emit/index.d.ts",
        "import": "./dist/emit/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ bin/",
    "tokens:check": "tsx bin/generate.ts --check",
    "tokens:write": "tsx bin/generate.ts --write",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
