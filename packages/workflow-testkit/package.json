{
  "name": "@generatorai/workflow-testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Test-only harness for whole workflow runs: real core services on an in-memory DB, a scripted FauxProvider, run snapshots and crash/restart. Consume it as a devDependency only.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@generatorai/agent-harness-providers": "workspace:*",
    "@generatorai/core": "workspace:*",
    "@generatorai/db": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@generatorai/workflow-spec": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
