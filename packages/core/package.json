{
  "name": "@generatorai/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@generatorai/changes": "workspace:*",
    "@generatorai/checkpoints": "workspace:*",
    "@generatorai/git": "workspace:*",
    "@generatorai/review": "workspace:*",
    "@generatorai/secrets": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@generatorai/source-control": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "kokoro-js": "^1.2.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.58.2",
    "yaml": "2.8.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.7.6",
    "@trycua/cua-driver": "0.19.3",
    "node-pty": "^1.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
