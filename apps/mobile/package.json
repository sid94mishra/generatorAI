    "expo-local-authentication": "~57.0.0",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^0.460.0",
    "marked": "^15.0.7",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
