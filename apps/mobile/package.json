    "@generatorai/client-runtime": "workspace:*",
    "@generatorai/client-transport": "workspace:*",
    "@generatorai/design-tokens": "workspace:*",
    "@generatorai/relay-protocol": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@generatorai/workflow-spec": "workspace:*",
    "@legendapp/list": "^3.3.11",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-sync-storage-persister": "^5.90.21",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
