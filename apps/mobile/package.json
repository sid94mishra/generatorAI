    "@generatorai/design-tokens": "workspace:*",
    "@generatorai/relay-protocol": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@gorhom/portal": "^1.0.14",
    "@legendapp/list": "^3.3.3",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-audio": "~57.0.0",
    "expo-camera": "~57.0.0",
    "expo-clipboard": "~57.0.0",
