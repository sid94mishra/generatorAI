    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^9.27.0",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "odiff-bin": "4.5.0",
    "sf-symbols-typescript": "^2.2.0",
    "tailwindcss": "4.3.3",
    "test-renderer": "^1.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  }
