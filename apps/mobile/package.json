{
  "name": "@generatorai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/start.mjs",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "export:android": "expo export --platform android --output-dir .expo-export",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node scripts/uniwind-artifacts.mjs && node scripts/gen-material-filled.mjs --check && eslint src/ app/ --quiet && node scripts/check-design.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "bundle:analyze": "expo export --platform android --output-dir .expo-export --source-maps && node scripts/check-bundle.mjs",
    "terminal:bundle": "node scripts/build-terminal-bundle.mjs",
    "vrt": "node ../../scripts/mobile/vrt.mjs",
    "perf": "node ../../scripts/mobile/perf.mjs",
    "check:design": "node scripts/uniwind-artifacts.mjs && node scripts/check-design.mjs",
    "test:ui": "jest",
    "test:kit": "jest",
    "test:unit": "vitest run",
    "uniwind:artifacts": "node scripts/uniwind-artifacts.mjs",
    "icons:filled": "node scripts/gen-material-filled.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
