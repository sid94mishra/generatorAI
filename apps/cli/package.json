{
  "name": "@generatorai/cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "generatorai": "./dist-bundle/generatorai.mjs"
  },
  "files": [
    "dist-bundle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node esbuild.config.mjs",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint src/",
    "dev": "tsx --import ./src/instrumentation.ts src/index.tsx",
    "docs": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "surface": "tsx scripts/generate-surface.ts",
    "surface:check": "tsx scripts/generate-surface.ts --check",
    "baseline": "tsx scripts/record-baseline.ts"
  },
  "devDependencies": {
    "@generatorai/agent-harness-providers": "workspace:*",
    "@generatorai/cli-core": "workspace:*",
    "@generatorai/client-core": "workspace:*",
    "@generatorai/client-runtime": "workspace:*",
    "@generatorai/client-transport": "workspace:*",
    "@generatorai/core": "workspace:*",
    "@generatorai/db": "workspace:*",
    "@generatorai/design-tokens": "workspace:*",
    "@generatorai/secrets": "workspace:*",
    "@generatorai/shared": "workspace:*",
    "@generatorai/tui-kit": "workspace:*",
    "@inquirer/prompts": "^7.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/instrumentation-pino": "^0.60.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@xterm/headless": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "esbuild": "^0.25.0",
    "ink": "^6.3.1",
    "ink-testing-library": "^4.0.0",
    "marked": "^15.0.0",
    "picocolors": "^1.1.1",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "string-width": "^7.2.0",
    "tsx": "^4.19.0",
    "ws": "^8.21.3",
    "yaml": "^2.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.11"
  }
}
