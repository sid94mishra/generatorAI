<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron ships a JIT; the hardened runtime blocks it without these. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- The embedded server and agent harnesses spawn helper processes and
         load their native modules from outside the app bundle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Loopback + outbound network for the embedded server and relay. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Agents read and write files in user-selected project directories. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Optional capabilities surfaced through the UI. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
